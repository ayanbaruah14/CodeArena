# MongoDB Atlas connection string
MONGO_URI=

# JWT secrets — use strong random strings (32+ characters) in production
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Server port (Render sets this automatically, leave empty for Render)
PORT=5500

# Frontend URL for CORS (your Vercel deployment URL)
CLIENT_URL=http://localhost:5173

# Redis URL for BullMQ queue (Render Redis internal URL or Upstash URL)
REDIS_URL=redis://127.0.0.1:6379

# Set to "production" on Render for secure cookies
NODE_ENV=development
